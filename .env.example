# Copie este arquivo para .env e preencha com os dados reais.
# No Render, essas variáveis são configuradas no painel (Environment), não em arquivo.

# URL de conexão com o PostgreSQL (Internal Database URL do Render, ou local para desenvolvimento)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/projexa

# Mercado Pago (assinatura) — use as credenciais de TESTE primeiro
MP_ACCESS_TOKEN=TEST-xxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx

# URL pública do seu site no Render (sem barra no final)
APP_URL=https://projexa-ue54.onrender.com
